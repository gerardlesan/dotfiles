// GENERATED by noctalia from ~/.config/noctalia/templates/niri-colors.kdl
// Do not edit ~/.config/niri/noctalia-colors.kdl: it is rewritten on every theme change.
// Role mapping (Material 3):
//   focus / active      -> primary
//   resting / inactive  -> outline
//   attention / urgent  -> error
//   overview backdrop   -> surface

layout {
    focus-ring {
        active-color "{{ colors.primary.default.hex }}"
        inactive-color "{{ colors.outline.default.hex }}"
        urgent-color "{{ colors.error.default.hex }}"
    }
    border {
        active-color "{{ colors.primary.default.hex }}"
        inactive-color "{{ colors.outline.default.hex }}"
        urgent-color "{{ colors.error.default.hex }}"
    }
    tab-indicator {
        active-color "{{ colors.primary.default.hex }}"
        inactive-color "{{ colors.outline.default.hex }}"
        urgent-color "{{ colors.error.default.hex }}"
    }
}

overview {
    backdrop-color "{{ colors.surface.default.hex }}"
}

recent-windows {
    highlight {
        active-color "{{ colors.primary.default.hex }}"
        urgent-color "{{ colors.error.default.hex }}"
    }
}

// The window being screen-shared gets the "danger" color.
window-rule {
    match is-window-cast-target=true
    focus-ring {
        active-color "{{ colors.error.default.hex }}"
        inactive-color "{{ colors.error.default.hex }}"
    }
}
