// GENERATED by noctalia from ~/.config/noctalia/templates/niri-colors.kdl
// Do not edit ~/.config/niri/noctalia-colors.kdl: it is rewritten on every theme change.
// Role mapping (Material 3):
//   focus / active      -> primary
//   resting / inactive  -> outline
//   attention / urgent  -> error
//   overview backdrop   -> surface

layout {
    focus-ring {
        active-color "#2ec09c"
        inactive-color "#297477"
        urgent-color "#ff0000"
    }
    border {
        active-color "#2ec09c"
        inactive-color "#297477"
        urgent-color "#ff0000"
    }
    tab-indicator {
        active-color "#2ec09c"
        inactive-color "#297477"
        urgent-color "#ff0000"
    }
}

overview {
    backdrop-color "#062329"
}

recent-windows {
    highlight {
        active-color "#2ec09c"
        urgent-color "#ff0000"
    }
}

// The window being screen-shared gets the "danger" color.
window-rule {
    match is-window-cast-target=true
    focus-ring {
        active-color "#ff0000"
        inactive-color "#ff0000"
    }
}
